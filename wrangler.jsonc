{
  "name": "voyagerroc-technologies",
  "main": "src/edge.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "voyagerroctechnologies.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CANONICAL_ORIGIN": "https://voyagerroctechnologies.com"
  }
}
